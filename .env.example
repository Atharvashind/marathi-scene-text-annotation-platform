# ── Required ───────────────────────────────────────────────────────────────────
# PostgreSQL credentials
POSTGRES_USER=annotation
POSTGRES_PASSWORD=changeme_strong_password

# JWT signing key — generate with: openssl rand -hex 32
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_generate_with_openssl_rand_base64_32

# ── Optional ───────────────────────────────────────────────────────────────────
# Frontend URL (used for CORS and NextAuth callbacks)
NEXTAUTH_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Storage backend: local | s3
IMAGE_STORAGE=local
# IMAGES_DIR is set inside Docker to /app/images (persistent volume)

# OCR engine: indic_photo_ocr | easyocr | paddleocr
ACTIVE_OCR_ENGINE=indic_photo_ocr
OCR_BATCH_SIZE=8

# Analytics provider: internal | posthog | mixpanel | opentelemetry
ANALYTICS_PROVIDER=internal

# Google OAuth (optional — leave empty to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# S3 storage (only needed if IMAGE_STORAGE=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
